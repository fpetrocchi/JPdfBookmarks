{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Maven: compile (reactor)",
      "type": "shell",
      "command": "mvn",
      "args": ["-q", "compile", "-DskipTests"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "presentation": {
        "reveal": "silent",
        "panel": "shared",
        "showReuseMessage": false
      },
      "problemMatcher": []
    }
  ]
}
