          <version>3.1.2</version>
      </plugin>
      
      <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-pmd-plugin</artifactId>
          <version>3.16.0</version>
      </plugin>   
     <plugin>
          <groupId>org.codehaus.mojo</groupId>
          <artifactId>findbugs-maven-plugin</artifactId>
          <version>3.0.5</version>
     </plugin>   
-->
      <plugin>
        <artifactId>maven-project-info-reports-plugin</artifactId>
        <version>3.2.1</version>
      </plugin>
    </plugins>
  </reporting>
  <modules>
    <module>Utilities</module>
    <module>ResourceHelper</module>
    <module>jpdfbookmarks_languages</module>
    <module>jpdfbookmarks_graphics</module>
    <module>Colors</module>
    <module>CollapsingPanel</module>
    <module>Bookmark</module>
    <module>iText-2.1.7-patched</module>
    <module>iTextBookmarksConverter</module>
    <module>jpdfbookmarks_docs</module>    
    <module>jpdfbookmarks_core</module>
  </modules>
</project>
